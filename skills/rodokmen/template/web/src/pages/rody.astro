---
import Base from '../layouts/Base.astro';
import PersonLink from '../components/PersonLink.astro';
import { lines, people, href, linesTitle } from '../lib/data.js';
import { t } from '../lib/i18n.js';
const list = Object.values(lines).sort((a, b) => a.k - b.k);
---
<Base title={t.linesPage.title}>
  <h1>{linesTitle(list.length)}</h1>
  <p class="lead">{t.linesPage.lead}</p>
  {list.length === 0 && <p>{t.linesPage.empty}</p>}
  <h2>{t.linesPage.paternal}</h2>
  <div class="grid2">
    {list.filter((l) => l.k < 12).map((l) => (
      <a class="card line-card card-link" style={`--c:${l.color}`} href={href.line(l.slug)}>
        <h3>{l.name}</h3>
        <p class="small">{l.desc}</p>
        <p class="small muted">{l.people.length} {t.linesPage.ancestorsCount} · {t.linesPage.startsAt} {people[l.root].name}</p>
      </a>
    ))}
  </div>
  <h2>{t.linesPage.maternal}</h2>
  <div class="grid2">
    {list.filter((l) => l.k >= 12).map((l) => (
      <a class="card line-card card-link" style={`--c:${l.color}`} href={href.line(l.slug)}>
        <h3>{l.name}</h3>
        <p class="small">{l.desc}</p>
        <p class="small muted">{l.people.length} {t.linesPage.ancestorsCount} · {t.linesPage.startsAt} {people[l.root].name}</p>
      </a>
    ))}
  </div>
</Base>
