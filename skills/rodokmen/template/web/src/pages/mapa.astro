---
import Base from '../layouts/Base.astro';
import FamilyMap from '../components/FamilyMap.astro';
import { t } from '../lib/i18n.js';
---
<Base title={t.mapPage.title} wider>
  <h1>{t.mapPage.h1}</h1>
  <p class="lead">{t.mapPage.lead}</p>
  <FamilyMap height="calc(100vh - 230px)" />
  <p class="small muted">{t.mapPage.note}</p>
</Base>
