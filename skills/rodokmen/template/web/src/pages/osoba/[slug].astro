---
import Base from '../../layouts/Base.astro';
import PersonLink from '../../components/PersonLink.astro';
import Record from '../../components/Record.astro';
import Pedigree from '../../components/Pedigree.astro';
import MobileTree from '../../components/MobileTree.astro';
import { people, families, lineByK, records, dateKey, href, statusClass } from '../../lib/data.js';
import { t } from '../../lib/i18n.js';

export function getStaticPaths() {
  return Object.keys(people).map((slug) => ({ params: { slug } }));
}
const p = people[Astro.params.slug];
const line = p.line ? lineByK[p.line] : null;
const recs = [...new Set(p.records)].filter((r) => records[r]).sort((a, b) => dateKey(records[a].date) - dateKey(records[b].date));
const path = [...p.path].reverse().filter(Boolean);
---
<Base title={p.name} description={`${p.name} ${p.years} – ${p.rel}`}>
  <div class="crumbs">
    {path.map((s, i) => <>{i > 0 && <span>→</span>}{s === p.slug ? <span>{people[s].name}</span> : <a href={href.person(s)}>{people[s].name.split(' ')[0]} {people[s].years}</a>}</>)}
  </div>
  <h1>{p.name}</h1>
  <div class="chips">
    {p.years && <span class="chip">{p.years}</span>}
    <span class="chip">{p.rel}</span>
    {line && <a class="chip" href={href.line(line.slug)}><span class="dot" style={`background:${line.color}`}></span>{t.personPage.linePrefix} {line.name}</a>}
    <span class={`chip ${statusClass(p.st)}`}>{p.status}</span>
  </div>

  {p.also.length > 0 && (
    <p class="note">{t.personPage.collapse1} {p.children.map((c, i) => <>{i > 0 && ` ${t.personPage.collapseAnd} `}<PersonLink slug={c} /></>)}.
      {' '}{t.personPage.collapse2} {p.also.map((a) => a.rel).join(', ')}.</p>
  )}
  {p.facts.length > 0 && <ul class="facts">{p.facts.map((f) => <li>{f}</li>)}</ul>}
  {p.note && <p class="note">{p.note}</p>}

  <h2>{t.personPage.familyHeading}</h2>
  <div class="grid2">
    <div class="card">
      <h3>{t.personPage.parents}</h3>
      {p.alt_parents ? (
        <>
          <p style="margin-bottom: 0.5rem;"><strong>{t.personPage.opt1}</strong><br />
            {t.personPage.father}: {p.father ? <PersonLink slug={p.father} /> : <span class="muted">{p.fatherUnknown ? t.personPage.fatherIlleg : t.personPage.fatherUnknown}</span>}<br />
            {t.personPage.mother}: {p.mother ? <PersonLink slug={p.mother} /> : <span class="muted">{t.personPage.motherUnknown}</span>}
          </p>
          <div style="margin-top: 0.6rem; padding-top: 0.6rem; border-top: 1px dashed rgba(128,128,128,0.3);">
            <p style="margin: 0;"><strong>{t.personPage.opt2} ({p.alt_parents.label}):</strong><br />
              {t.personPage.father}: <strong>{p.alt_parents.father}</strong><br />
              {t.personPage.mother}: <strong>{p.alt_parents.mother}</strong><br />
              <span class="muted" style="font-size: 0.85em; display: inline-block; margin-top: 0.25rem;">{p.alt_parents.note}</span>
            </p>
          </div>
        </>
      ) : (
        <p>{t.personPage.father}: {p.father ? <PersonLink slug={p.father} /> : <span class="muted">{p.fatherUnknown ? t.personPage.fatherIlleg : t.personPage.fatherUnknown}</span>}<br />
          {t.personPage.mother}: {p.mother ? <PersonLink slug={p.mother} /> : <span class="muted">{t.personPage.motherUnknown}</span>}</p>
      )}
      {p.family && <p class="small"><a href={href.family(p.family)}>{t.personPage.originFamily}</a></p>}
    </div>
    {p.child && (
      <div class="card">
        <h3>{p.sex === 'M' ? t.personPage.wifeAndChild : t.personPage.husbandAndChild}</h3>
        <p>{p.spouse ? <PersonLink slug={p.spouse} /> : <span class="muted">{p.sex === 'F' && people[p.child]?.fatherUnknown ? t.personPage.fatherNotListed : t.personPage.unknownPartner}</span>}<br />
          {p.children.length > 1 ? t.personPage.childrenInLine : t.personPage.childInLine}: {p.children.map((c, i) => <>{i > 0 && ', '}<PersonLink slug={c} /></>)}
          {p.ownFamily && families[p.ownFamily]?.side?.length > 0 && (
            <><br /><span class="small muted">{t.personPage.otherChildren}: {families[p.ownFamily].side.map((s, i) => <>{i > 0 && ', '}<strong>{s.name}</strong></>)}</span></>
          )}
        </p>
        {p.ownFamily && <p class="small"><a href={href.family(p.ownFamily)}>{t.personPage.theirFamily}</a></p>}
      </div>
    )}
  </div>

  {p.side.length > 0 && (
    <>
      <h2>{t.personPage.sideHeading}</h2>
      <div class="grid2">
        {p.side.map((s) => (
          <div class="card"><h3>{s.name}</h3><p class="small">{s.text}</p>
            {s.records.length > 0 && <p class="small">{t.personPage.recordsLabel}: {s.records.filter((r) => records[r]).map((r, i) => <>{i > 0 && ' · '}<a href={href.record(r)}>{records[r].date}</a></>)}</p>}
          </div>
        ))}
      </div>
    </>
  )}

  <h2>{t.personPage.ancestorsHeading}</h2>
  <div class="only-desktop"><Pedigree k={p.k} /></div>
  <div class="only-mobile"><MobileTree k={p.k} /></div>

  {p.docs.length > 0 && (
    <>
      <h2>{t.personPage.docsHeading}</h2>
      <div class="docs">{p.docs.map((d) => <figure><a href={`/img/${d.img}.jpg`} target="_blank" rel="noopener"><img src={`/img/${d.img}.jpg`} alt={d.caption} loading="lazy" /></a><figcaption>{d.caption}</figcaption></figure>)}</div>
    </>
  )}

  <h2>{t.personPage.recordsHeading}</h2>
  {recs.length ? <div class="recs">{recs.map((r) => <Record id={r} showPeople exclude={p.slug} />)}</div>
    : <p class="muted">{t.personPage.noRecords}{p.st === 'fam' ? ` ${t.personPage.noRecordsFam}` : ''}.</p>}
</Base>
