---
import Base from '../../layouts/Base.astro';
import PersonLink from '../../components/PersonLink.astro';
import Record from '../../components/Record.astro';
import { lines, people, hypotheses, href, genName, statusClass, lineByK, config } from '../../lib/data.js';
import { t } from '../../lib/i18n.js';

export function getStaticPaths() {
  return Object.keys(lines).map((slug) => ({ params: { slug } }));
}
const l = lines[Astro.params.slug];
const members = l.people.map((s) => ({ ...people[s], gen: l.gens[s] }));
const gens = [...new Set(members.map((p) => p.gen))].sort((a, b) => a - b);
const partnerLine = lineByK[l.k ^ 1];
const lineStudies = (config.studie ?? []).filter((s) => s.rod === l.slug);
---
<Base title={`${t.linePage.titlePrefix} ${l.name}`}>
  <p class="crumbs"><a href="/rody/">{t.linePage.crumbs}</a></p>
  <h1><span style={`display:inline-block;width:.8em;height:.8em;border-radius:50%;background:${l.color};margin-right:.3em`}></span>{l.name}</h1>
  <p class="lead">{l.desc}</p>
  <p>{t.linePage.startsAt} <PersonLink slug={l.root} /> ({people[l.root].rel}).
    {partnerLine && people[l.root].spouse && (
      <> {people[l.root].sex === 'M' ? t.linePage.wife : t.linePage.husband} <PersonLink slug={people[l.root].spouse} /> {t.linePage.isRootOf} <a href={href.line(partnerLine.slug)}>{partnerLine.name}</a>; {t.linePage.their} {people[people[l.root].child].sex === 'M' ? t.linePage.son : t.linePage.daughter} <PersonLink slug={people[l.root].child} />.</>
    )}
  </p>
  <p class="small muted">{t.linePage.note}</p>

  {lineStudies.length > 0 && (
    <>
      <h2>{t.linePage.studiesHeading}</h2>
      <div class="grid2" style="margin: 1rem 0 1.5rem 0;">
        {lineStudies.map((s) => (
          <a class="card line-card card-link" style={`--c:${l.color}`} href={`/${s.slug}/`}>
            <h3 style="margin-top:0;">{s.nadpis}</h3>
            {s.text && <p class="small muted">{s.text}</p>}
            <p class="small" style="margin-bottom:0;">{t.linePage.readStudy}</p>
          </a>
        ))}
      </div>
    </>
  )}

  {gens.map((g) => (
    <>
      <h2>{genName(g)}</h2>
      <div class="table-box"><table>
        <thead><tr><th>{t.linePage.thName}</th><th>{t.linePage.thLife}</th><th>{t.linePage.thFacts}</th><th>{t.linePage.thStatus}</th></tr></thead>
        <tbody>
          {members.filter((p) => p.gen === g).map((p) => (
            <tr>
              <td><PersonLink slug={p.slug} showYears={false} /></td>
              <td class="small">{p.years}</td>
              <td class="small">{p.facts.slice(0, 2).join(' · ')}</td>
              <td><span class={`chip ${statusClass(p.st)}`}>{p.status}</span></td>
            </tr>
          ))}
        </tbody>
      </table></div>
    </>
  ))}

  {hypotheses.filter((h) => h.line === l.k).map((h) => (
    <>
      <h2>{h.title}</h2>
      {h.text && <p class="prose">{h.text}</p>}
      {h.items.length > 0 && <ul class="facts">{h.items.map((o) => <li><strong>{o.name}</strong> – {o.text}</li>)}</ul>}
      <div class="recs">{h.records.map((r) => <Record id={r} />)}</div>
    </>
  ))}
</Base>
