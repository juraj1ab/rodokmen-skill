---
import Base from '../../layouts/Base.astro';
import PersonLink from '../../components/PersonLink.astro';
import { records, recordList } from '../../lib/data.js';
import { t } from '../../lib/i18n.js';

export function getStaticPaths() {
  return recordList.map((r) => ({ params: { key: r.key } }));
}
const r = records[Astro.params.key];
---
<Base title={r.title} wide>
  <p class="crumbs"><a href="/zapisy/">{t.recordDetail.crumbs}</a> · <span class="kind">{r.kindName}</span></p>
  <h1>{r.title}</h1>
  <p class="lead">{r.summary}</p>
  <div class="table-box"><table>
    <tbody>
      <tr><th>{t.recordDetail.date}</th><td>{r.date}</td></tr>
      <tr><th>{t.recordDetail.archive}</th><td>{r.archive}</td></tr>
      <tr><th>{t.recordDetail.volume}</th><td>{r.volume}</td></tr>
      <tr><th>{t.recordDetail.scan}</th><td>{r.scan}{r.url && <> – <a href={r.url} target="_blank" rel="noopener">{t.recordDetail.openPortal} {r.portal}</a></>}</td></tr>
      {r.people.length > 0 && <tr><th>{t.recordDetail.people}</th><td>{r.people.map((s, i) => <>{i > 0 && ', '}<PersonLink slug={s} /></>)}</td></tr>}
    </tbody>
  </table></div>
  {r.img && (
    <p style="margin-top:1rem">
      <a href={r.full ? `/zdroje/${r.key}.jpg` : `/img/${r.key}.jpg`} target="_blank" rel="noopener"><span class="hl-wrap" style="border:1px solid var(--line);border-radius:8px"><img src={`/img/${r.key}.jpg`} alt={`${t.recordDetail.cropAlt}: ${r.title}`} />{r.boxes.map(([x0, y0, x1, y1]) => <span class="hl" style={`left:${x0 * 100}%;top:${y0 * 100}%;width:${(x1 - x0) * 100}%;height:${(y1 - y0) * 100}%`}></span>)}</span></a>
      <br /><span class="small muted">{r.boxes.length ? t.recordDetail.redBoxHint : ''}{r.full ? t.recordDetail.fullResHint : ''}</span>
    </p>
  )}
  {r.orig && (
    <div class="transcript">
      <div class="tr-grid">
        <div><h2>{t.recordDetail.origHeading}</h2><p class="tr-orig">{r.orig}</p></div>
        <div><h2>{t.recordDetail.transHeading}</h2><p class="tr-cs">{r.cs}</p></div>
      </div>
      <p class="small muted">{t.recordDetail.uncertainNote}</p>
    </div>
  )}
</Base>
